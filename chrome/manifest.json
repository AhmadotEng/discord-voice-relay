{
  "manifest_version": 3,
  "name": "Discord Direct for Chrome",
  "short_name": "Direct",
  "version": "0.3.0",
  "minimum_chrome_version": "111",
  "description": "Toggle the local Discord Web voice and screen-share route from the toolbar. The native helper runs only while enabled with a Discord tab open.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "Discord Direct: Off — click to enable",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "src/relay-config.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "host_permissions": [
    "https://discord.com/*"
  ]
}
