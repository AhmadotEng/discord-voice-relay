{
  "manifest_version": 3,
  "name": "Discord Voice Relay for Chrome",
  "short_name": "Voice Relay",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Routes Discord Web voice through a user-provided TURN-over-TCP/TLS relay in Chrome and Chromium browsers.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "Discord Voice Relay",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "src/relay-config.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/channels/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
